# Outdoor firmware: build tree and built images (rebuild with `tos.py build`;
# publish firmware binaries as GitHub release assets instead)
Outdoor/.build/
Outdoor/dist/
# MQTT TLS pre-shared key (generated per installation; see Indoor/tools/setup_mqtt_tls.sh)
Outdoor/src/doorbell_secret.h
Indoor/mqtt_psk.txt
# camera login (Settings > Camera)
Indoor/secrets.json

# Indoor dashboard: per-device state and caches
Indoor/settings.json
Indoor/news_cache.json
Indoor/app.log
Indoor/app.log.old
# your own ring tones (e.g. film songs you own) stay on your Pi
Indoor/assets/tones/mine/
__pycache__/
*.pyc

# Editor settings with paths of one PC
.vscode/
# ring recordings (video of visitors) stay on the Pi
Indoor/recordings/
# the dashboard's Python environment (voice packages) and downloaded models
Indoor/.venv/
Indoor/models/
