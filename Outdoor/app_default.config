# Start from the board-specific config in your current TuyaOpen checkout.
# These settings are based on WAVESHARE_T5AI_TOUCH_AMOLED_1_75.config.
CONFIG_PROJECT_VERSION="1.0.1"
CONFIG_TUYA_PRODUCT_ID="vdkfqxw300mfu8py"
CONFIG_ENABLE_BATTERY=y
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_WAVESHARE_T5AI_TOUCH_AMOLED_1_75=y
CONFIG_ENABLE_LVGL_TP=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_DISPLAY_DEFAULT_BRIGHTNESS=80

CONFIG_ENABLE_LIBLVGL=y
